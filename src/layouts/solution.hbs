<!DOCTYPE html>
<html lang="en">
  <head>
{{> head defaultPageTitle='Untitled'}}
{{> head-component-color}}
  </head>
  {{!-- page-solution is the record the solutions-catalog extension writes at
        build time. It is parsed per partial (solution=...) so every shared
        partial (header, nav, footer) keeps the root context. When the
        attribute is missing the data-solution-* attributes are omitted and
        28-solution-progress.js leaves the page alone.

        Shell: the same as default pages (main > .content holds article.doc
        and a sidebar aside), so the on-this-page TOC script can read the
        article's headings. The left nav owns navigation; the body Steps list
        (solution-steps) carries the ticks on the overview; the right rail is
        the progress card, the TOC and the code panel. --}}
  <body class="article solution{{#with (or page.attributes.role page.role)}} {{{this}}}{{/with}}" data-component="{{page.component.name}}"{{#with (get-header-color page)}} data-component-color="{{{this}}}"{{/with}}{{#with (parse-json page.attributes.solution)}} data-solution-id="{{id}}" data-solution-version="{{version}}" data-solution-status="{{status}}" data-solution-download="{{download}}"{{#if draftDownloads}} data-solution-draft-downloads="true"{{/if}} data-solution-title="{{title}}" data-solution-file-count="{{files.length}}"{{#if verified.platforms.length}} data-solution-tested-on="{{platform-list verified.platforms}}"{{/if}} data-solution-step-count="{{steps.length}}"{{/with}}>
{{> header}}
<div class="body no-keep-markup">
{{> nav}}
<main class="article solution">
  {{> toolbar}}
  <div class="content sol-content">
    <article class="doc sol-doc">
      {{> breadcrumbs}}
      {{> solution-hero solution=(parse-json page.attributes.solution)}}
      {{!-- The outcome diagram: the first thing after the title and the
            description, above the metadata panel. --}}
      {{> solution-outcome}}
      {{> solution-meta solution=(parse-json page.attributes.solution)}}
      {{!-- The Steps list goes right after the introduction, before the
            first authored section: it is what the reader came to start, and
            Architecture or Prerequisites should not push it below the fold.
            It is a sect1 with an h2, so On this page lists it. --}}
      {{#with (split-at-first-section page.contents) as |parts|}}
      {{{parts.before}}}
      {{> solution-steps solution=(parse-json @root.page.attributes.solution)}}
      {{{parts.after}}}
      {{/with}}
      {{> solution-related-docs solution=(parse-json page.attributes.solution)}}
      {{> solution-overview-next solution=(parse-json page.attributes.solution)}}
      {{> feedback-footer}}
      {{> tracking-pixel}}
    </article>
    <aside class="sol-rail">
      <details class="sol-rail-details" data-sol-rail open>
        {{!-- #with, not a subexpression in a path: Handlebars parses
             {{(helper x).y}} only when the template is rendered, and then
             throws, which fails the whole site build. --}}
        <summary class="sol-rail-summary">Progress and code{{#with (parse-json page.attributes.solution)}}<span class="sol-rail-summary-meta"><span data-sol-progress-count>0 of {{steps.length}}</span> done</span>{{/with}}</summary>
        <div class="sol-rail-body">
          {{> solution-progress solution=(parse-json page.attributes.solution)}}
          {{> toc}}
        </div>
      </details>
    </aside>
  </div>
  {{> footer}}
</main>
</div>
{{> chat-panel}}
  </body>
</html>
