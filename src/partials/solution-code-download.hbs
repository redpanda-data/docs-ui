{{!--
  "Get the code" section of the rail's progress card. solution-progress.hbs
  includes it FIRST, above the progress bar: the code is what a reader needs
  at the start of a step, and progress is something they glance at. Single
  files are downloaded from the Download control on each code block, not
  from a list here. Context:
  `solution`.

  Knowledge is never gated: every file a reader needs is shown in full on a
  page of the solution. Downloads are the shortcut, and they are gated alike:
  the complete bundle and each single file are served by the docs-site
  /solutions/download function, which owns the sign-in redirect for
  `authenticated` solutions. The repository itself is private and its URL is
  deliberately never rendered here. Download and run (authenticated only)
  gets a short-lived signed link from /solutions/download-link instead, so
  the command works in a terminal with no docs session.
--}}
{{#unless (eq solution.download 'none')}}
<div class="sol-card-section sol-download" data-sol-download-panel role="group" aria-labelledby="sol-download-title">
  <h3 id="sol-download-title" class="sol-card-label">Get the code</h3>
  <a class="sol-btn sol-btn--sm{{#if (eq solution.download 'authenticated')}} sol-btn--primary{{/if}}"
     href="/solutions/download?solution={{solution.id}}&amp;version={{solution.version}}&amp;return={{@root.page.url}}"
     data-sol-download
     {{#if (eq solution.download 'authenticated')}}data-requires-auth{{/if}}
     data-analytics="solution_download"
     rel="nofollow">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
    <span data-sol-download-label>Download the complete example</span>
  </a>
  {{#if solution.asset}}
  <p class="sol-download-asset"><code>{{solution.asset}}</code></p>
  {{/if}}
  {{!-- Download and run: for a signed-in reader a click asks docs-site
    /solutions/download-link for a ten-minute link and shows a curl command
    that fetches the bundle, unzips it and starts the stack
    (28-solution-progress.js builds the command). Signed out, it asks for
    sign-in like the download above. --}}
  {{#if (eq solution.download 'authenticated')}}
  <div class="sol-download-run" data-sol-download-run>
    <button type="button" class="sol-btn sol-btn--sm" data-sol-download-run-button data-analytics="solution_download_run">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
      <span>Download and run</span>
    </button>
    <div class="sol-download-run-output" data-sol-download-run-output role="status" hidden></div>
  </div>
  {{/if}}
  {{#if (eq solution.download 'authenticated')}}
  {{> solution-access-gate}}
  {{/if}}
</div>
{{/unless}}
