{{!--
  "Get the code" panel for the rail. Context: `solution`.

  Knowledge is never gated: every file a reader needs is shown in full on a
  page of the solution. Downloads are the shortcut, and they are gated alike:
  the complete bundle and each single file are served by the docs-site
  /solutions/download function, which owns the sign-in redirect for
  `authenticated` solutions. The repository itself is private and its URL is
  deliberately never rendered here.
--}}
{{#unless (eq solution.download 'none')}}
<section class="sol-panel sol-download" data-sol-download-panel aria-labelledby="sol-download-title">
  <h3 id="sol-download-title" class="sol-panel-title">Get the code</h3>
  <p class="sol-panel-text">Build it yourself from the steps, or download the complete working example.</p>
  <a class="sol-btn sol-btn--sm{{#if (eq solution.download 'authenticated')}} sol-btn--primary{{/if}}"
     href="/solutions/download?solution={{solution.id}}&amp;version={{solution.version}}&amp;return={{@root.page.url}}"
     data-sol-download
     {{#if (eq solution.download 'authenticated')}}data-requires-auth{{/if}}
     data-analytics="solution_download"
     rel="nofollow">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
    <span data-sol-download-label>Download the complete example</span>
  </a>
  {{#if solution.asset}}
  <p class="sol-download-asset"><code>{{solution.asset}}</code></p>
  {{/if}}
  {{#if (eq solution.download 'authenticated')}}
  {{> solution-access-gate}}
  {{/if}}
</section>
{{/unless}}
{{!-- All build-along files: `solution.files`, the download allowlist, which
      is every file the pages show in full. Each entry downloads that one file
      through the same endpoint, sign-in gate and intent round trip as the
      Download control on a code block (28-solution-progress.js wires both, and
      rewrites each href with the same URL builder). A draft has no release, so
      its entries render with no href at all. Nothing here links to a public
      copy of a file: there is none.

      The list is open on the overview, where it is the point of the panel. On
      a step page each step lists its own files under Files for this step, so
      the list starts collapsed rather than pushing the rest of the rail below
      the fold. --}}
{{#if solution.files.length}}
{{#unless (eq solution.download 'none')}}
<section class="sol-panel sol-files" data-sol-files-panel aria-labelledby="sol-files-title">
  <details class="sol-files-details"{{#if (eq @root.page.layout 'solution')}} open{{/if}}>
  <summary class="sol-files-summary"><h3 id="sol-files-title" class="sol-panel-title">All build-along files ({{solution.files.length}})</h3></summary>
  <p class="sol-panel-text" data-sol-files-text>{{#if (eq solution.status 'draft')}}Every file is shown in full on the steps. Download available at release.{{else if (eq solution.download 'authenticated')}}Every file is shown in full on the steps. Sign in to download any of them.{{else}}Every file is shown in full on the steps. Download any of them here.{{/if}}</p>
  <ul class="sol-file-list">
    {{#each solution.files}}
    <li>
      {{#if (eq ../solution.status 'draft')}}
      <a class="sol-file-link is-disabled" aria-disabled="true" data-sol-file-link="{{this}}" title="{{this}}: Download available at release">
      {{else}}
      <a class="sol-file-link" href="/solutions/download?solution={{encode-uri ../solution.id}}&amp;version={{encode-uri ../solution.version}}&amp;path={{encode-uri this}}&amp;return={{encode-uri @root.page.url}}"
         data-sol-file-link="{{this}}"
         {{#if (eq ../solution.download 'authenticated')}}data-requires-auth{{/if}}
         data-analytics="solution_download"
         aria-label="Download {{this}}"
         title="Download {{this}}"
         rel="nofollow">
      {{/if}}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>{{this}}</span>
      </a>
    </li>
    {{/each}}
  </ul>
  </details>
</section>
{{/unless}}
{{/if}}
