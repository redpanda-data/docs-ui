{{!--
  The sticky bar every docs page has (article.hbs): the component pill, the
  page's badges, and Page options, so a Solutions page opens the way a Connect
  or Streaming page does. Context: `solution` (the parsed page-solution
  record), plus `runAt`, `version`, and `platforms` for the Verified badge;
  the evidence counts come from the record's verified block when it has them.
  The overview passes the record's verified block; a step page passes the
  scalar mirrors the solutions-catalog extension sets on it.

  The Verified badge renders nothing when runAt does not parse as a date, the
  same rule as the overview's metadata strip. Its visible text is the date; the
  version and platforms are in the tooltip and in the screen-reader text, from
  one inline so the two cannot drift.
--}}
{{#*inline "sol-verified-text"}}Last verified {{verifiedAt}}{{#with version}} against Redpanda {{this}}{{/with}}{{#if platforms.length}} on {{platform-list platforms names=(lookup (get-solutions-catalog) 'platformNames')}}{{/if}}.{{#if evidence}} {{evidence}}.{{/if}}{{/inline}}
<div class="component-indicator-sticky sol-indicator">
  {{#with (get-header-data @root.page)}}
  <div class="component-indicator">
    <span class="component-indicator-pill" style="background: var(--component-color, #6366f1);">
      {{#if this.title}}{{{this.title}}}{{else}}{{@root.page.component.title}}{{/if}}
    </span>
  </div>
  {{/with}}
  {{#with (format-release-date runAt long=true) as |verifiedAt|}}
  <span class="status-badge status-badge--verified" data-tippy-content="{{> sol-verified-text verifiedAt=verifiedAt version=../version platforms=../platforms evidence=(format-verified-evidence ../solution.verified names=(lookup (get-solutions-catalog) 'platformNames'))}}">
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
    <span aria-hidden="true">Verified {{verifiedAt}}</span>
    <span class="status-badge__sr-text">{{> sol-verified-text verifiedAt=verifiedAt version=../version platforms=../platforms evidence=(format-verified-evidence ../solution.verified names=(lookup (get-solutions-catalog) 'platformNames'))}}</span>
  </span>
  {{/with}}
  {{#if solution.id}}{{> markdown-dropdown @root companionUrl=(or solution.agentCompanion (concat '/solutions/' solution.id '/agent-companion.md'))}}{{/if}}
</div>
