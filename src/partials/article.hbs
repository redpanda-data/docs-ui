<article class="doc {{#if page.attributes.no-toc}}no-toc{{/if}}">
{{#if (and (ne page.attributes.role 'home') (ne page.attributes.role 'component-home-v3') (ne page.attributes.role 'bloblang-playground'))}}
{{> breadcrumbs}}
{{/if}}
{{#if (and (not page.attributes.cloud) (ne page.attributes.role 'bloblang-playground'))}}
{{> latest-banner}}
{{/if}}
{{#if (eq page.attributes.role 'bloblang-playground')}}
{{> bloblang-signup-form}}
{{/if}}
{{#if (eq page.attributes.role 'home')}}
  {{> home}}
  {{page.contents}}
{{else if (eq page.attributes.role 'component-home-v3')}}
  {{!-- component-home-v3 renders its own title in the hero section --}}
{{else}}
  {{!-- Component indicator pill, version selector, and status badges - sticky header --}}
  <div class="component-indicator-sticky">
    {{#with (get-header-data page)}}
    <div class="component-indicator">
      <span class="component-indicator-pill" style="background: var(--component-color, #6366f1);">
        {{#if this.title}}{{{this.title}}}{{else}}{{@root.page.component.title}}{{/if}}
      </span>
    </div>
    {{/with}}
    {{> version-selector}}
    {{!-- Status badges: Beta, Preview, Limited availability, Since (version).
         One look per meaning (.rp-badge in meaning.css). The tooltip comes from
         data-tooltip (12-activate-tooltips.js); page-*-text attributes override
         the standard text. --}}
    {{#if page.attributes.beta}}
    <span class="rp-badge rp-badge--beta" data-tooltip="{{#if page.attributes.beta-text}}{{page.attributes.beta-text}}{{else}}Beta: available to try, and may change before general availability.{{/if}}">Beta</span>
    {{/if}}
    {{#if page.attributes.preview}}
    <span class="rp-badge rp-badge--preview" data-tooltip="{{#if page.attributes.preview-text}}{{page.attributes.preview-text}}{{else}}Preview: not covered by Enterprise Support or SLAs, and may change.{{/if}}">Preview</span>
    {{/if}}
    {{#if page.attributes.limited-availability}}
    <span class="rp-badge rp-badge--limited" data-tooltip="{{#if page.attributes.limited-availability-text}}{{page.attributes.limited-availability-text}}{{else}}Limited availability: open to selected customers.{{/if}}">Limited availability</span>
    {{/if}}
    {{!-- Version badge: the release that introduced the page's feature.
         :page-introduced-in: takes a bare X.Y.Z (a leading v or trailing period
         is stripped). :page-introduced-in-product: names the product in the
         tooltip, for example "Redpanda Connect"; without it the tooltip says
         "version". Never shown on Cloud pages: a self-managed version doesn't
         apply there, even if a single-sourced page carries the attribute. --}}
    {{#if (and page.attributes.introduced-in (not page.attributes.cloud))}}
    {{#with (normalize-version page.attributes.introduced-in)}}
    {{!-- One source for the tooltip and the screen reader text, so they can't drift --}}
    {{#*inline "introduced-in-text"}}Introduced in {{#if @root.page.attributes.introduced-in-product}}{{@root.page.attributes.introduced-in-product}}{{else}}version{{/if}} {{this}}.{{/inline}}
    <span class="rp-badge rp-badge--since" data-tooltip="{{> introduced-in-text}}"><span aria-hidden="true">Since v{{this}}</span><span class="rp-badge__sr-text">{{> introduced-in-text}}</span></span>
    {{/with}}
    {{/if}}
    {{!-- ADP platform badges: only show when limited to one platform --}}
    {{#if page.attributes.adp}}
    {{#if page.attributes.byoc-only}}
    <span class="rp-badge rp-badge--cloud" data-tooltip="Available only in BYOC (Bring Your Own Cloud) clusters.">BYOC</span>
    {{else if page.attributes.cloud-only}}
    <span class="rp-badge rp-badge--cloud" data-tooltip="Available only in fully managed Redpanda Cloud clusters.">Cloud</span>
    {{/if}}
    {{/if}}
    {{!-- Inline metadata: context switcher and availability badges --}}
    {{#if (or page.attributes.context-switcher page.attributes.cloud-available page.attributes.self-managed-available page.attributes.self-managed-only page.attributes.byoc page.attributes.cloud-only)}}
    {{#unless page.attributes.adp}}
    <div class="metadata-inline">
      {{#if page.attributes.context-switcher}}
        {{> context-switcher}}
      {{/if}}
      {{!-- Connector availability badges: links to the other platform's page --}}
      {{#if page.attributes.cloud-available}}
        <a href="{{page.attributes.cloud-available-url}}" class="rp-badge rp-badge--cloud" data-tooltip="Available in Redpanda Cloud.">Cloud</a>
      {{/if}}
      {{#if page.attributes.self-managed-available}}
        <a href="{{page.attributes.self-managed-available-url}}" class="rp-badge rp-badge--self-managed" data-tooltip="Available in Self-Managed Redpanda.">Self-Managed</a>
      {{/if}}
      {{#if page.attributes.self-managed-only}}
        <span class="rp-badge rp-badge--self-managed" data-tooltip="Available only in Self-Managed Redpanda.">Self-Managed</span>
      {{/if}}
      {{!-- BYOC and Cloud badges for non-ADP pages --}}
      {{#if page.attributes.byoc}}
        <span class="rp-badge rp-badge--cloud" data-tooltip="{{#if page.attributes.byoc-text}}{{page.attributes.byoc-text}}{{else}}Available in Redpanda Cloud BYOC clusters.{{/if}}">BYOC</span>
      {{/if}}
      {{#if page.attributes.cloud-only}}
        <span class="rp-badge rp-badge--cloud" data-tooltip="{{#if page.attributes.cloud-only-text}}{{page.attributes.cloud-only-text}}{{else}}Available in Redpanda Cloud.{{/if}}">Cloud</span>
      {{/if}}
    </div>
    {{/unless}}
    {{/if}}
    {{!-- Page options dropdown - now in sticky header with other metadata --}}
    {{> markdown-dropdown}}
  </div>
  {{#with page.title}}
    <h1 class="page">{{{this}}}</h1>
  {{/with}}
{{/if}}
{{!-- Metadata moved to sticky bar above, this block kept for backwards compatibility but hidden --}}
{{#unless (or (eq page.attributes.role 'component-home-v2') (eq page.attributes.role 'component-home-v3'))}}
<div class="metadata metadata--main" style="display: none;">
  {{!-- Metadata now shown in sticky bar above --}}
</div>
{{/unless}}
{{#if page.attributes.console-config-migrator}}
{{> console-config-migrator}}
{{/if}}
{{#if (eq page.attributes.role 'component-home')}}
  {{> component-home}}
{{else if (eq page.attributes.role 'component-home-v2')}}
  {{> component-home-v2}}
{{else if (eq page.attributes.role 'component-home-v3')}}
  {{> component-home-v3}}
{{else if (eq page.attributes.role 'bloblang-playground')}}
  {{> bloblang-playground}}
{{else if (eq page.attributes.role 'index-list')}}
  {{> index-list}}
{{else if (eq page.layout 'index')}}
  {{> index}}
{{else if (eq page.attributes.role 'related-labs')}}
  {{#with (list-related-labs page.title page.attributes page.contents)  as |listLabs|}}
    {{{lazy-images listLabs}}}
  {{/with}}
{{else}}
  {{!-- The default article body. lazy-images marks images below the fold
        loading="lazy" at build time (see the helper). --}}
  {{#with (add-suggested-labs page.attributes page.contents)  as |suggestedLabs|}}
    {{{lazy-images suggestedLabs}}}
  {{/with}}
{{/if}}
{{#if (and (ne page.attributes.role 'home') (ne page.attributes.role 'component-home-v3'))}}
{{> back-to-top}}
{{/if}}
{{> feedback-footer}}
{{> pagination}}
{{> tracking-pixel}}
</article>
