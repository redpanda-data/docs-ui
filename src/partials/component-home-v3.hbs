    <h2 class="ch3-section-title">{{{page.attributes.component-cards-title}}}</h2>
    <div class="ch3-deploy-grid">
      {{#if page.attributes.component-1-name}}
      <a class="ch3-deploy-card ch3-component-card" href="{{#if page.attributes.component-1-link}}{{{relativize (resolve-resource page.attributes.component-1-link)}}}{{/if}}"
         style="--component-color: {{or (get-component-color site (get-component-from-resource page.attributes.component-1-link)) '#1f5bd6'}}">
        <h3 class="ch3-deploy-title">
          {{page.attributes.component-1-name}}
          {{#if (or page.attributes.component-1-is-new (ne page.attributes.component-1-deployments 'all'))}}
          <span class="ch3-component-badges">
            {{#if page.attributes.component-1-is-new}}
            <span class="ch3-component-badge ch3-component-badge--new">NEW</span>
            {{/if}}
            {{#if (eq page.attributes.component-1-deployments 'byoc')}}
            <span class="ch3-component-badge ch3-component-badge--byoc">Cloud BYOC</span>
            {{/if}}
          </span>
          {{/if}}
        </h3>
        {{#if page.attributes.component-1-desc}}
        <p class="ch3-deploy-desc">{{page.attributes.component-1-desc}}</p>
        {{/if}}
        {{#if page.attributes.component-1-features}}
        <ul class="ch3-component-features">
          {{#each (split page.attributes.component-1-features ';;')}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
        {{/if}}
        <div class="ch3-deploy-foot">
          <span class="ch3-deploy-cta">{{#if page.attributes.component-1-cta-text}}{{page.attributes.component-1-cta-text}}{{else}}Open docs{{/if}}</span>
        </div>
      </a>
      {{/if}}

      {{#if page.attributes.component-2-name}}
