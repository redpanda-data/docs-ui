          {{else if (eq page.attributes.deploy-2-icon 'plug-connected')}}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 2v4"/><path d="M17 2v4"/><path d="M7 6h10a2 2 0 0 1 2 2v6a4 4 0 0 1-4 4h-6a4 4 0 0 1-4-4V8a2 2 0 0 1 2-2"/><path d="M12 18v4"/></svg>
          {{else if (eq page.attributes.deploy-2-icon 'plug')}}
