    <h2 class="ch3-section-title">{{{page.attributes.deploy-title}}}</h2>
    <div class="ch3-deploy-grid">
      {{#if page.attributes.deploy-1-title}}
      <a class="ch3-deploy-card" href="{{#if page.attributes.deploy-1-link}}{{{relativize (resolve-resource page.attributes.deploy-1-link)}}}{{/if}}">
