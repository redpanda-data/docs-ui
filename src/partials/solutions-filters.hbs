{{!--
  Landing page filters. Context: `catalog` from get-solutions-catalog.
  Rendered as <details> so it can collapse on narrow screens; on desktop the
  summary is hidden and 29-solutions-home.js keeps it open. Filtering is
  client-side over the embedded catalog JSON with URL state
  (?q=&category=&difficulty=&tech=&platform=).
--}}
<details class="sol-filters" data-sol-filters open>
  <summary class="sol-filters-summary">
    <span>Filters</span>
    <span class="sol-filters-active" data-sol-filters-active hidden></span>
  </summary>
  <form class="sol-filters-body" data-sol-filters-form role="search" onsubmit="return false">
    <label class="sol-search">
      <span class="visually-hidden">Search Solutions</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="search" name="q" placeholder="Search by title, technology, or category" autocomplete="off" data-sol-filter-q>
    </label>
    {{#if catalog.facets.difficulty.length}}
    <fieldset class="sol-filter-group">
      <legend class="sol-filter-title">Difficulty</legend>
      {{#each catalog.facets.difficulty}}
      <label class="sol-filter-row"><input type="checkbox" name="difficulty" value="{{this}}"><span class="sol-diff is-{{this}}">{{this}}</span></label>
      {{/each}}
    </fieldset>
    {{/if}}
    {{#if catalog.facets.categories.length}}
    <fieldset class="sol-filter-group">
      <legend class="sol-filter-title">Category</legend>
      {{#each catalog.facets.categories}}
      <label class="sol-filter-row"><input type="checkbox" name="category" value="{{this}}"><span>{{this}}</span></label>
      {{/each}}
    </fieldset>
    {{/if}}
    {{#if catalog.facets.technologies.length}}
    <fieldset class="sol-filter-group">
      <legend class="sol-filter-title">Technology</legend>
      {{#each catalog.facets.technologies}}
      <label class="sol-filter-row"><input type="checkbox" name="tech" value="{{this}}"><span>{{this}}</span></label>
      {{/each}}
    </fieldset>
    {{/if}}
    {{#if catalog.facets.platforms.length}}
    <fieldset class="sol-filter-group">
      <legend class="sol-filter-title">Runs on</legend>
      {{#each catalog.facets.platforms}}
      <label class="sol-filter-row"><input type="checkbox" name="platform" value="{{this}}"><span>{{#if (eq this 'self-managed')}}Self-Managed{{else if (eq this 'cloud')}}Cloud{{else}}{{this}}{{/if}}</span></label>
      {{/each}}
    </fieldset>
    {{/if}}
    <button type="button" class="sol-link-btn sol-filters-clear" data-sol-filters-clear hidden>Clear filters</button>
  </form>
</details>
