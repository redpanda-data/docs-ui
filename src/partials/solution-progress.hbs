{{!--
  Compact progress card for the right rail. Context: `solution`.
  Navigation (Solutions home, Overview, the ordered steps with ticks) lives in
  the left nav (nav-tree-solution); this card only shows state: bar, "n of M
  steps", state text, the version-changed notice, and Save progress with its
  status line. Mark step complete deliberately is NOT here. It used to be, as
  a full-width primary button above Get the code, which made the most
  prominent control on the page an action the reader takes last, and invited
  marking a step before doing it. The only Mark step complete is the one
  under the article (solution-step-actions.hbs), where a reader who has just
  finished the step is. The done block below is
  repeated in the step action row (data-sol-done-inline) because the rail
  collapses on narrow screens. Get the code (solution-code-download.hbs)
  opens the card, above the progress bar, because the code is what a reader
  needs first on a step; the progress block closes it. There is no list of
  every file here: each step's Files for this step section and the Download
  control on each code block cover that. Progress, download and sign-in are
  still one box; when the download is
  gated its sign-in line replaces Sign in to sync, which would ask for the
  same sign-in twice. Everything is driven by
  28-solution-progress.js, which reads the step ids from the sidebar entries
  (data-sol-nav-step) or the overview's Steps list (data-sol-step-id).
--}}
<section class="sol-panel sol-progress" data-sol-progress data-sol-step-count="{{solution.steps.length}}" aria-labelledby="sol-progress-title">
  {{> solution-code-download solution=solution}}
  <div class="sol-panel-head">
    <h3 id="sol-progress-title" class="sol-panel-title">Your progress</h3>
    <span class="sol-progress-count"><span data-sol-progress-count>0 of {{solution.steps.length}}</span> steps</span>
  </div>
  <div class="sol-bar" role="progressbar" aria-labelledby="sol-progress-title" aria-valuemin="0" aria-valuemax="{{solution.steps.length}}" aria-valuenow="0" aria-valuetext="0 of {{solution.steps.length}} steps complete" data-sol-progress-bar>
    <div class="sol-bar-fill" data-sol-progress-fill style="width: 0%"></div>
  </div>
  <p class="sol-progress-state" data-sol-progress-state>Not started</p>
  <div class="sol-version-notice" data-sol-version-notice role="status" hidden>
    <p>This solution has been updated to <code data-sol-version-new>{{solution.version}}</code> since you last worked on it. Your progress is kept, but some steps may have changed.</p>
    <button type="button" class="sol-link-btn" data-sol-version-dismiss>Got it</button>
  </div>
  <div class="sol-progress-actions">
    <button type="button" class="sol-btn sol-btn--ghost sol-btn--sm" data-sol-save data-sol-save-card data-intent="save" data-analytics="solution_save_progress" hidden>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
      <span data-sol-save-label>Sign in to sync</span>
    </button>
    <span class="sol-sync-state" data-sol-sync-state aria-live="polite"></span>
  </div>
  <div class="sol-done" data-sol-done hidden>
    <p class="sol-done-title">You finished this solution.</p>
    <p class="sol-done-sub">Keep the complete example around for your own projects.</p>
    {{#unless (eq solution.download 'none')}}
    <a class="sol-btn sol-btn--primary sol-btn--sm" href="/solutions/download?solution={{solution.id}}&amp;version={{solution.version}}&amp;return={{@root.page.url}}" data-sol-download {{#if (eq solution.download 'authenticated')}}data-requires-auth{{/if}} data-analytics="solution_download" rel="nofollow"><span data-sol-download-label>Download the complete example</span></a>
    {{/unless}}
    {{> solution-productionize-link solution=solution}}
  </div>
</section>
