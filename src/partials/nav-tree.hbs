{{#if navigation.length}}
<ul class="nav-list">
  {{#each navigation}}
  <li class="nav-item" data-depth="{{or ../level 0}}">
    {{#if ./content}}
    <div class="item {{#if (eq ./url @root.page.url)}}is-current-page{{/if}} {{#if ./items.length}}dropdown{{/if}}">
    {{#if ./url}}
    <a class="nav-link" href="
      {{~#if (eq ./urlType 'internal')}}{{{relativize ./url}}}
      {{~else}}{{{./url}}}{{~/if}}">{{{./content}}}
      {{~#if (is-beta-feature ./url)}} <span class="rp-badge rp-badge--sm rp-badge--beta">Beta</span>{{/if}}
      {{~#if (is-preview-feature ./url)}} <span class="rp-badge rp-badge--sm rp-badge--preview">Preview</span>{{/if}}
      {{~#if (is-limited-availability-feature ./url)}} <span class="rp-badge rp-badge--sm rp-badge--limited">Limited availability</span>{{/if}}
      {{~#unless @root.page.attributes.adp}}
      {{~#if (is-byoc-feature ./url)}} <span class="rp-badge rp-badge--sm rp-badge--cloud">BYOC</span>{{/if}}
      {{~#if (is-cloud-feature ./url)}} <span class="rp-badge rp-badge--sm rp-badge--cloud">Cloud</span>{{/if}}
      {{~/unless}} </a>
    {{else}}
    <span class="nav-text">{{{./content}}} </span>
    {{/if}}
    {{#if ./items.length}}
    <div role="button" tabindex="0" aria-label="Expand navigation" class="nav-item-toggle"><img src="{{{@root.uiRootPath}}}/img/nav-tree-chevron.svg" width="6" height="10" alt=""></div>
    {{/if}}
    </div>
    {{/if}}
    {{#if ./items.length}}
      {{!-- Defer only what the reader can open again: an item with no content
            renders no row and no .nav-item-toggle, so a <template> here is a
            dead end. Every bucket's tree is rooted in exactly such a titleless
            item, which is how the whole sidebar came up empty. --}}
      {{#if (and ./content (not (or (eq ./url @root.page.url) (nav-contains-current ./items @root.page.url))))}}
      {{!-- Collapsed at load (01-nav.js only opens the current path): keep the
            subtree out of the document until the reader expands it. On a long
            product tree this is most of the sidebar. --}}
      <template data-nav-lazy>{{> nav-tree navigation=./items level=(increment ../level)}}</template>
      {{else}}
{{> nav-tree navigation=./items level=(increment ../level)}}
      {{/if}}
    {{/if}}
  </li>
  {{/each}}
</ul>
{{/if}}
