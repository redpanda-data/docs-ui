{{#if navigation.length}}
<ul class="nav-list">
  {{#each navigation}}
  <li class="nav-item" data-depth="{{or ../level 0}}">
    {{#if ./content}}
    <div class="item {{#if (eq ./url @root.page.url)}}is-current-page{{/if}} {{#if ./items.length}}dropdown{{/if}}">
    {{#if ./url}}
    <a class="nav-link {{~#if (is-beta-feature ./url)}} cloud-beta{{~/if}}{{~#if (is-preview-feature ./url)}} cloud-preview{{~/if}}{{~#if (is-limited-availability-feature ./url)}} cloud-limited-availability{{~/if}}{{~#unless @root.page.attributes.adp}}{{~#if (is-byoc-feature ./url)}} cloud-byoc{{~/if}}{{~#if (is-cloud-feature ./url)}} cloud-only{{~/if}}{{~/unless}}" href="
      {{~#if (eq ./urlType 'internal')}}{{{relativize ./url}}}
      {{~else}}{{{./url}}}{{~/if}}">{{{./content}}} </a>
    {{else}}
    <span class="nav-text">{{{./content}}} </span>
    {{/if}}
    {{#if ./items.length}}
    <div role="button" tabindex="0" aria-label="Expand navigation" class="nav-item-toggle"><img src="{{{@root.uiRootPath}}}/img/nav-tree-chevron.svg" width="6" height="10" alt=""></div>
    {{/if}}
    </div>
    {{/if}}
    {{#if ./items.length}}
      {{#if (or (eq ./url @root.page.url) (nav-contains-current ./items @root.page.url))}}
{{> nav-tree navigation=./items level=(increment ../level)}}
      {{else}}
      {{!-- Collapsed at load (01-nav.js only opens the current path): keep the
            subtree out of the document until the reader expands it. On a long
            product tree this is most of the sidebar. --}}
      <template data-nav-lazy>{{> nav-tree navigation=./items level=(increment ../level)}}</template>
      {{/if}}
    {{/if}}
  </li>
  {{/each}}
</ul>
{{/if}}
