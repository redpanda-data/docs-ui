{{!--
  "Take this to production" link in a done panel (solution-progress.hbs and
  the inline copy in solution-step-actions.hbs). Context: `solution`. It goes
  to the Take it to production page (solution.production), and on that page
  to its card (#take-to-production), so the link only scrolls. A solution
  built without that page keeps the card on its last step, so the link goes
  there.
--}}
{{#if (eq @root.page.layout 'solution-production')}}
<a class="sol-done-link" href="#take-to-production" data-sol-productionize-link data-analytics="solution_productionize_link">Take this to production</a>
{{else if solution.production.url}}
<a class="sol-done-link" href="{{{relativize solution.production.url}}}" data-sol-productionize-link data-analytics="solution_productionize_link">Take this to production</a>
{{else}}
{{#with (lookup solution.steps (subtract solution.steps.length 1)) as |last|}}
<a class="sol-done-link" href="{{{relativize (concat last.url '#take-to-production')}}}" data-sol-productionize-link data-analytics="solution_productionize_link">Take this to production</a>
{{/with}}
{{/if}}
