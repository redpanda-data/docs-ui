{{!--
  Step page footer actions: explicit mark-complete (the only way a step is
  ever marked), save, and prev/next from page-solution-prev/next-url/title.
  Context: `solution`.

  It also carries a compact copy of the progress bar and the step counter,
  shown only where the right rail collapses. The rail's progress card is the
  only place either appears otherwise, so on a phone the reader could mark
  steps complete with nothing telling them how far through they were.
  28-solution-progress.js drives both copies: every selector it renders
  through uses querySelectorAll, so the duplicate needs no JavaScript change.
--}}
<nav class="sol-step-actions" aria-label="Step actions">
  <div class="sol-step-actions-progress">
    <span class="sol-step-actions-count">
      <span data-sol-progress-count>0 of {{solution.steps.length}}</span> steps
    </span>
    <div class="sol-bar" role="progressbar" aria-valuemin="0" aria-valuemax="{{solution.steps.length}}" aria-valuenow="0" data-sol-progress-bar>
      <div class="sol-bar-fill" data-sol-progress-fill style="width: 0%"></div>
    </div>
  </div>
  <div class="sol-step-actions-main">
    <button type="button" class="sol-btn sol-btn--primary" data-sol-complete data-analytics="solution_step_complete" aria-pressed="false">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      <span data-sol-complete-label>Mark step complete</span>
    </button>
    <button type="button" class="sol-btn sol-btn--ghost" data-sol-save data-intent="save" data-analytics="solution_save_progress">
      <span data-sol-save-label>Save progress</span>
    </button>
  </div>
  <div class="sol-step-actions-nav">
    {{#if @root.page.attributes.solution-prev-url}}
    <a class="sol-btn sol-btn--ghost sol-step-nav" data-sol-prev href="{{{relativize @root.page.attributes.solution-prev-url}}}">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <span class="sol-step-nav-text"><span class="sol-step-nav-kicker">Previous</span>{{@root.page.attributes.solution-prev-title}}</span>
    </a>
    {{else}}
    <a class="sol-btn sol-btn--ghost sol-step-nav" data-sol-prev href="{{{relativize solution.url}}}">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <span class="sol-step-nav-text"><span class="sol-step-nav-kicker">Back to</span>Overview</span>
    </a>
    {{/if}}
    {{#if @root.page.attributes.solution-next-url}}
    <a class="sol-btn sol-step-nav sol-step-nav--next" data-sol-next href="{{{relativize @root.page.attributes.solution-next-url}}}">
      <span class="sol-step-nav-text"><span class="sol-step-nav-kicker">Next</span>{{@root.page.attributes.solution-next-title}}</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </a>
    {{else}}
    <a class="sol-btn sol-step-nav sol-step-nav--next" data-sol-finish href="{{{relativize solution.url}}}">
      <span class="sol-step-nav-text"><span class="sol-step-nav-kicker">Last step</span>Back to overview</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </a>
    {{/if}}
  </div>
</nav>
