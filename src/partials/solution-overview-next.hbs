{{!--
  The overview's closing action: the same Start CTA as the hero, at the end
  of the article, so a reader who has read the whole overview can start
  without scrolling back up. It carries data-sol-start, so
  28-solution-progress.js gives it the same href and label as the hero
  (Continue, Start again) and the same Start again confirmation.
  Context: `solution`.
--}}
{{#with solution.steps.[0]}}
<nav class="sol-overview-next" aria-label="Start this solution">
  <a class="sol-btn sol-btn--primary" href="{{{relativize this.url}}}" data-sol-start data-analytics="solution_start">
    <span data-sol-start-label>Start building</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
  </a>
  <span class="sol-overview-next-step">Step 1: {{title}}</span>
</nav>
{{/with}}
