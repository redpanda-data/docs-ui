{{!--
  Step page header. Context: `solution` plus the step-page attributes the
  solutions-catalog extension sets (page-solution-step-index/count, and the
  scalar mirrors page-solution-verified-at/version).
--}}
{{> solution-indicator solution=solution runAt=@root.page.attributes.solution-verified-at version=@root.page.attributes.solution-verified-version platforms=solution.verified.platforms}}
{{#with (get-solution-step solution) as |step|}}
{{!-- Inside this block the context is the step; ../solution is the partial's own context. --}}
<header class="sol-step-header">
  <div class="sol-eyebrow">
    <a class="sol-eyebrow-link" href="{{{relativize ../solution.url}}}">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      {{../solution.title}}
    </a>
    <span class="sol-eyebrow-sep" aria-hidden="true">/</span>
    <span class="sol-eyebrow-label">Step {{@root.page.attributes.solution-step-index}} of {{@root.page.attributes.solution-step-count}}</span>
  </div>
  {{#with @root.page.title}}
  <h1 class="page sol-title">{{{this}}}</h1>
  {{/with}}
  <div class="sol-step-facts is-before-toc">
    {{!-- Last verified is the Verified badge in the sticky bar above
          (solution-indicator.hbs). --}}
    <span class="sol-fact sol-fact--status" data-sol-step-header-status hidden>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      Completed
    </span>
  </div>
</header>
{{else}}
<header class="sol-step-header">
  <div class="sol-eyebrow">
    <a class="sol-eyebrow-link" href="{{{relativize solution.url}}}">{{solution.title}}</a>
  </div>
  {{#with @root.page.title}}
  <h1 class="page sol-title">{{{this}}}</h1>
  {{/with}}
</header>
{{/with}}
